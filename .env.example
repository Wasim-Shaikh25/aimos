# AIMOS environment — LOCAL / DEV template.
# Copy to `.env` (git-ignored) and fill in. Paper trading needs NO exchange keys.
#
#   cp .env.example .env
#   docker compose up            # or: python -m aimos.runtime.paper_trader
#
# Every AIMOS__* var overrides a config/*.yaml key (double-underscore = nesting).

# ---- mode ----
AIMOS__MODE=paper                       # paper | live (live requires the §23.8 gate ladder)

# ---- bind address & port ----
# Local dev: leave AIMOS_HOST unset or set 127.0.0.1.
# Container/PaaS: set AIMOS_HOST=0.0.0.0 (already the default in Dockerfile).
# Coolify/other PaaS may expose the port as `PORT`; AIMOS_PORT takes precedence.
AIMOS_HOST=127.0.0.1
AIMOS_PORT=8000
# PORT=8000                             # PaaS fallback when AIMOS_PORT is not set

# ---- feature flags (mirror config/default.yaml `features:`) ----
AIMOS__FEATURES__TELEGRAM_ENABLED=false # set true AND fill TELEGRAM_BOT_TOKEN below to get messages
AIMOS__FEATURES__LIVE_DATA=false        # false = fully offline synthetic run (no network, no keys)
                                        # true  = fetch live PUBLIC candles (still no keys)
AIMOS__FEATURES__LLM_NEWS_SENSOR=false  # true needs ANTHROPIC_API_KEY
AIMOS__FEATURES__SCALP_ENABLED=false

# ---- paper loop ----
AIMOS__PAPER__DATA_EXCHANGE=binance     # PUBLIC data venue (no keys)
AIMOS__PAPER__LOOP_SECONDS=300
AIMOS__PAPER__MAX_TICKS=5               # 0 = run forever; small number for a quick test run

# ---- Telegram (the ONLY secret paper mode can use; optional) ----
TELEGRAM_BOT_TOKEN=                     # from @BotFather
TELEGRAM_ALLOWED_IDS=                   # comma-separated numeric chat IDs (whitelist)

# ---- optional: LLM (news sensor + AI analyst) ----
ANTHROPIC_API_KEY=                      # Anthropic — news sensor and/or the AI analyst
OPENAI_API_KEY=                         # OpenAI — alternative (cheaper) AI-analyst backend
# AI analyst (read-only Q&A + reports on UI + Telegram). Off unless enabled + a key:
# AIMOS__ASSISTANT__ENABLED=true
# AIMOS__ASSISTANT__PROVIDER=openai     # anthropic (default) | openai

# ---- storage ----
# Optional: one PostgreSQL URL for journal + state + controls + model registry + user settings.
# Leave empty to use the local SQLite fallback (state/aimos.sqlite).
AIMOS__STORAGE__DATABASE_URL=

AIMOS__PAPER__JOURNAL_PATH=state/aimos.sqlite   # hash-chained decision journal (SQLite fallback)
POSTGRES_PASSWORD=aimos                 # TimescaleDB password (docker-compose)
AIMOS_TIMESCALE_DSN=                    # set to use TimescaleDB time-series (needs .[timescale]):
                                        #   postgresql://aimos:aimos@postgres:5432/aimos
                                        # empty = off (SQLite journal only)

# ---- single-user auth (set these before exposing the dashboard publicly) ----
AIMOS_ADMIN_USERNAME=admin
AIMOS_ADMIN_PASSWORD=                   # required for dashboard login
# AIMOS_JWT_SECRET=                     # optional; generated and saved under ~/.aimos/secrets/.jwt_secret if unset

# ---- exchange account keys (binance / kraken / coinbase) --------------------
# Paper trading + price monitoring need NO keys — leave this whole block empty.
# Keys are used ONLY for account access (balances, and live orders after the
# §23.8 go-live ladder). Add them securely through the Settings UI (encrypted at
# rest). For local/headless runs you can still use:
# Option A: the encrypted settings store (Settings UI)
# Option B: a secrets file (see secrets.example.yaml)
AIMOS_SECRETS_FILE=                     # e.g. /run/secrets/aimos.yaml
#
# Option C: per-venue env vars (uncomment + fill the venues you trade)
# AIMOS_KEY_BINANCE=
# AIMOS_SECRET_BINANCE=
# AIMOS_KEY_KRAKEN=
# AIMOS_SECRET_KRAKEN=
# AIMOS_KEY_COINBASE=
# AIMOS_SECRET_COINBASE=
