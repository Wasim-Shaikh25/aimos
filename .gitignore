# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Virtualenvs / local Python version pins
.venv/
venv/
env/
.python-version

# Data & state (never commit market data, journals, secrets)
# NOTE: anchored to repo root so they don't swallow the aimos/data/ source package.
/data/
/state/
/runs/
/proposals/
*.parquet
*.sqlite
*.db
llm_cache/

# Secrets — real env files ignored; *.example templates are committed
.env
.env.*
!.env.example
!.env.prod.example
*.key
/secrets.*                     # root-level real secret files only (anchored so it does
!secrets.example.yaml          # not catch aimos/account/secrets.py); template committed

# stray heartbeat if the server is run from a subdir
dashboard/state/

# OS
.DS_Store

# Runtime control files
RUNTIME_HALT

# Node / dashboard build artifacts
node_modules/
dashboard/dist/
dashboard/package-lock.json
