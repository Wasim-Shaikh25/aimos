# AIMOS environment — PRODUCTION template (still PAPER until the §23.8 go-live ladder).
# Copy to `.env.prod` (git-ignored), fill in, and point compose at it:
#   docker compose --env-file .env.prod up -d

AIMOS__MODE=paper                       # stays paper until go-live gates cleared

AIMOS__FEATURES__TELEGRAM_ENABLED=true  # prod: alerts on
AIMOS__FEATURES__LIVE_DATA=true         # prod: live PUBLIC candles (no API keys)
AIMOS__FEATURES__LLM_NEWS_SENSOR=false
AIMOS__FEATURES__SCALP_ENABLED=false
# AIMOS__FEATURES__SAAS_ENABLED=true     # enable single-admin login + encrypted settings UI

# Single-admin auth (required when saas_enabled is true)
# AIMOS__SAAS__ADMIN__USER_ID=admin
# AIMOS__SAAS__ADMIN__EMAIL=admin@example.com
# AIMOS__SAAS__ADMIN__PASSWORD='__set_me__'
# AIMOS__SAAS__SMTP__HOST=smtp.example.com
# AIMOS__SAAS__SMTP__PORT=587
# AIMOS__SAAS__SMTP__USERNAME=__set_me__
# AIMOS__SAAS__SMTP__PASSWORD=__set_me__
# AIMOS__SAAS__SMTP__FROM=AIMOS <noreply@example.com>

AIMOS__PAPER__DATA_EXCHANGE=binance
AIMOS__PAPER__LOOP_SECONDS=300
AIMOS__PAPER__MAX_TICKS=0               # run forever

TELEGRAM_BOT_TOKEN=__set_me__
TELEGRAM_ALLOWED_IDS=__set_me__

# Exchange account keys (binance / kraken / coinbase) — account access + live orders.
# Live orders are refused until the §23.8 ladder + mandate.yaml are complete.
# Withdrawals DISABLED, IP-whitelisted (§23.4).
# When SaaS is enabled, add keys through the Settings UI (encrypted at rest).
# For headless/legacy setups, use a secrets file or env vars:
AIMOS_SECRETS_FILE=/run/secrets/aimos.yaml   # see secrets.example.yaml
# AIMOS_KEY_BINANCE=__set_me__
# AIMOS_SECRET_BINANCE=__set_me__
# AIMOS_KEY_KRAKEN=__set_me__
# AIMOS_SECRET_KRAKEN=__set_me__
# AIMOS_KEY_COINBASE=__set_me__
# AIMOS_SECRET_COINBASE=__set_me__
